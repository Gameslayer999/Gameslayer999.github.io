---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tech, image, imageAlt, repo, demo } = project.data;
---

<Base title={title} description={summary}>
  <article>
    <a href="/#projects" class="back">← All projects</a>
    <h1>{title}</h1>
    <p class="summary">{summary}</p>
    <ul class="tags">{tech.map((t) => <li>{t}</li>)}</ul>
    <p class="links">
      {demo && <a href={demo}>Live demo →</a>}
      {repo && <a href={repo}>Source code →</a>}
    </p>
    {image && <div class="hero-img"><img src={image} alt={imageAlt ?? ''} /></div>}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  article { max-width: 680px; padding-top: 16px; }
  .back { color: var(--muted); font-size: 15px; }
  h1 { font-size: clamp(2rem, 5vw, 2.6rem); margin: 16px 0 8px; }
  .summary { font-size: 1.15rem; color: var(--muted); margin: 0 0 16px; }
  .links { display: flex; gap: 20px; margin: 20px 0; }
  .hero-img {
    background: var(--tag); border: 1px solid var(--border); border-radius: 14px;
    padding: 24px; margin: 24px 0 8px; display: grid; place-items: center;
  }
  .hero-img img { max-height: 320px; width: auto; }
  .prose :global(h2) { font-size: 1.3rem; margin-top: 36px; }
  .prose :global(li) { margin-bottom: 6px; }
</style>
