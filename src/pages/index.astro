---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const links = [
  { label: 'GitHub', href: SITE.github },
  { label: 'LinkedIn', href: SITE.linkedin },
  { label: 'Résumé', href: SITE.resume },
  { label: 'Email', href: SITE.email && `mailto:${SITE.email}` },
].filter((l) => l.href);
---

<Base>
  <section class="hero">
    <h1>Hi, I'm {SITE.name.split(' ')[0]}.</h1>
    <p class="tagline">{SITE.tagline}</p>
    <p class="links">
      {links.map((l) => <a href={l.href}>{l.label} →</a>)}
    </p>
  </section>

  <section id="projects">
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={`/projects/${p.id}/`}>
          {p.data.image ? (
            <div class="thumb"><img src={p.data.image} alt={p.data.imageAlt ?? ''} loading="lazy" /></div>
          ) : (
            <div class="thumb placeholder">{p.data.title}</div>
          )}
          <div class="body">
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <ul class="tags">{p.data.tech.map((t) => <li>{t}</li>)}</ul>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="about">
    <h2>About</h2>
    <p>{SITE.bio}</p>
  </section>
</Base>

<style>
  .hero { padding: 48px 0 56px; }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.2rem); margin: 0 0 12px; }
  .tagline { font-size: 1.25rem; color: var(--muted); margin: 0 0 20px; max-width: 36ch; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; margin: 0; }
  section { margin-bottom: 56px; }
  h2 { font-size: 1.4rem; margin: 0 0 20px; }
  .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .card {
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    overflow: hidden; color: var(--text);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover { transform: translateY(-3px); border-color: var(--accent); text-decoration: none; }
  .thumb {
    aspect-ratio: 16 / 9; display: grid; place-items: center;
    background: var(--tag); position: relative;
  }
  .thumb img {
    position: absolute; inset: 16px;
    width: calc(100% - 32px); height: calc(100% - 32px); object-fit: contain;
  }
  .thumb.placeholder { font-size: 1.6rem; font-weight: 700; color: var(--muted); }
  .body { padding: 16px 18px 20px; }
  .body h3 { margin: 0 0 6px; font-size: 1.1rem; }
  .body p { margin: 0 0 14px; color: var(--muted); font-size: 15px; }
</style>
